---
import { hero } from "../lib/content";
import Button from "./ui/Button.astro";
import MisureWord from "./ui/MisureWord.astro";
---

<section id="inicio" class="scroll-mt-24">
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 px-4 py-16 md:grid-cols-[55%_45%] md:gap-16 md:px-6 md:py-28"
  >
    <div>
      <h1
        data-reveal
        class="font-display max-w-xl text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl md:text-[3.4rem]"
      >
        {hero.title}
      </h1>
      <p
        data-reveal
        style={{ transitionDelay: "60ms" }}
        class="mt-6 max-w-xl text-lg leading-relaxed text-green/80"
      >
        <MisureWord text={hero.lead} />
      </p>
      <div
        data-reveal
        style={{ transitionDelay: "120ms" }}
        class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4"
      >
        <Button href={hero.ctaPrimary.href} class="w-full sm:w-auto">
          {hero.ctaPrimary.label}
        </Button>
        <Button href={hero.ctaSecondary.href} variant="outline" class="w-full sm:w-auto">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>
    <div
      data-reveal
      style={{ transitionDelay: "120ms" }}
      class="relative mx-auto flex aspect-square w-full max-w-lg items-center justify-center rounded-full bg-cream-dark/50"
    >
      <div class="flex aspect-[4/3] w-3/4 flex-col overflow-hidden rounded-lg border-2 border-green-dark bg-green shadow-none">
        <div class="flex h-8 items-center gap-2 bg-green-dark/50 px-3">
          <div class="h-3 w-3 rounded-full bg-cream/40"></div>
          <div class="h-3 w-3 rounded-full bg-cream/60"></div>
          <div class="h-3 w-3 rounded-full bg-cream/80"></div>
        </div>
        <div class="flex flex-1 flex-col gap-3 p-5">
          <div class="h-3 w-3/4 rounded bg-cream"></div>
          <div class="h-3 w-1/2 rounded bg-cream/70 ml-4"></div>
          <div class="h-3 w-5/6 rounded bg-cream/80 ml-4"></div>
          <div class="h-3 w-2/3 rounded bg-cream/60 animate-pulse"></div>
          <div class="h-3 w-3/4 rounded bg-cream/70 ml-8"></div>
          <div class="h-3 w-1/3 rounded bg-cream/50 ml-8 animate-pulse"></div>
          <div class="h-3 w-4/5 rounded bg-cream/60 ml-4"></div>
          <div class="flex items-center gap-1">
            <div class="h-3 w-1/2 rounded bg-cream/40"></div>
            <div class="h-4 w-3 animate-pulse bg-cream"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
